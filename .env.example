# Identifiants de votre profil SNCB (Mon SNCB). Ne jamais committer le fichier .env.
SNCB_EMAIL=prenom.nom@example.com
SNCB_PASSWORD=votre-mot-de-passe

# Port de l'interface locale
PORT=3000

# true = navigateur invisible ; false = vous voyez le robot remplir le formulaire
HEADLESS=true

# Facultatif : chemin vers un Chromium déjà installé
# CHROMIUM_PATH=/opt/pw-browsers/chromium
